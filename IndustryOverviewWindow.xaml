<Window x:Class="TradeGame.IndustryOverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="产业与仓库总览" Height="700" Width="960"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 标题与汇总 -->
            <RowDefinition Height="*"/>     <!-- 产业总览：每座作坊一行 -->
            <RowDefinition Height="220"/>   <!-- 仓库总览：每城一行 -->
            <RowDefinition Height="180"/>   <!-- 库存明细：每种货物一行 -->
            <RowDefinition Height="Auto"/>  <!-- 关闭 -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="产业与仓库总览" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock x:Name="SummaryText" Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="产业总览（每座作坊一行；规模决定作坊位与可建等级）" Padding="6">
            <DataGrid x:Name="IndustryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="城市" Binding="{Binding City}" Width="90"/>
                    <DataGridTextColumn Header="规模" Binding="{Binding Size}" Width="60"/>
                    <DataGridTextColumn Header="作坊位" Binding="{Binding Slots}" Width="80"/>
                    <DataGridTextColumn Header="产业类型" Binding="{Binding TypeName}" Width="*"/>
                    <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="70"/>
                    <DataGridTextColumn Header="配方" Binding="{Binding Recipe}" Width="150"/>
                    <DataGridTextColumn Header="原料供给" Binding="{Binding Supply}" Width="140"/>
                    <DataGridTextColumn Header="等级" Binding="{Binding Tier}" Width="60"/>
                    <DataGridTextColumn Header="日产" Binding="{Binding DailyOutput}" Width="70"/>
                    <DataGridTextColumn Header="产地" Binding="{Binding Origins}" Width="160"/>
                    <DataGridTextColumn Header="本城仓库" Binding="{Binding WarehouseInfo}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="仓库总览（每城一行，未建造的显示「未建」；可在此修改自动卖出）" Margin="0,8,0,0" Padding="6">
            <DataGrid x:Name="WarehouseGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single"
                      SelectionChanged="WarehouseGrid_SelectionChanged"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="城市" Binding="{Binding City}" Width="90"/>
                    <DataGridTextColumn Header="仓库等级" Binding="{Binding Level}" Width="90"/>
                    <DataGridTextColumn Header="容量" Binding="{Binding Capacity}" Width="80"/>
                    <DataGridTextColumn Header="已用" Binding="{Binding Used}" Width="80"/>
                    <DataGridTextColumn Header="剩余" Binding="{Binding Free}" Width="80"/>
                    <DataGridTextColumn Header="库存" Binding="{Binding StockSummary}" Width="*"/>
                    <DataGridTextColumn Header="占用量" Binding="{Binding UsageRate}" Width="90"/>
                    <DataGridTextColumn Header="自动卖出" Binding="{Binding AutoSell}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="库存明细（按城市与货物展开）" Margin="0,8,0,0" Padding="6">
            <DataGrid x:Name="StockGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="城市" Binding="{Binding City}" Width="90"/>
                    <DataGridTextColumn Header="货物" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="产地" Binding="{Binding Origins}" Width="200"/>
                    <DataGridTextColumn Header="库存数量" Binding="{Binding Quantity}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <Button Content="关闭" DockPanel.Dock="Right" Width="100" Height="26"
                    Click="CloseButton_Click"/>
            <Button x:Name="AutoSellApplyButton" Content="应用" DockPanel.Dock="Right" Width="70"
                    Height="26" Margin="8,0,0,0" Click="AutoSellApplyButton_Click"/>
            <ComboBox x:Name="AutoSellBox" DockPanel.Dock="Right" Width="150" Height="26" Margin="8,0,0,0"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Text="选中仓库总览里的城市，即可修改该城仓库的自动卖出节奏"/>
        </DockPanel>
    </Grid>
</Window>
