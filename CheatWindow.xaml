<Window x:Class="TradeGame.CheatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="作弊台" Height="240" Width="380" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="GoldText" FontSize="14" FontWeight="SemiBold"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="金额" VerticalAlignment="Center"/>
            <TextBox x:Name="AmountBox" Width="140" Height="24" Margin="8,0,0,0"/>
            <Button Content="设为该金额" Width="90" Height="24" Margin="8,0,0,0"
                    Click="SetGoldButton_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="增加该金额" Width="90" Height="24" Click="AddGoldButton_Click"/>
            <Button Content="减少该金额" Width="90" Height="24" Margin="8,0,0,0"
                    Click="SubtractGoldButton_Click"/>
            <Button Content="+10000" Width="70" Height="24" Margin="8,0,0,0"
                    Click="QuickAddButton_Click" Tag="10000"/>
            <Button Content="+1000" Width="70" Height="24" Margin="8,0,0,0"
                    Click="QuickAddButton_Click" Tag="1000"/>
        </StackPanel>

        <TextBlock Grid.Row="3" x:Name="StatusText" Foreground="Gray" Margin="0,10,0,0"
                   TextWrapping="Wrap"/>

        <Button Grid.Row="4" Content="关闭（修改立即生效）" Width="150" Height="26"
                VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
